{
  "name": "zhiya",
  "version": "1.22.0",
  "description": "枝桠 Zhiya —— 逆向 Xmind 复刻的单文件思维导图（工程化版）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:verify": "node test/verify.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test": "npm run build && npm run check && npm run test:unit && npm run test:verify && npm run test:e2e && npm run test:marathon && npm run test:launcher",
    "fixtures:pack": "node --experimental-strip-types scripts/pack-xmind-fixtures.mjs",
    "test:marathon": "npm run fixtures:pack && node test/marathon.mjs",
    "release": "node scripts/make-release.mjs",
    "test:launcher": "node test/launcher-smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.50.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^3.0.0"
  }
}
